# ArcReel 生产环境配置（PostgreSQL）
# 复制为 .env 后填入你的值

# ============================================================
# 认证配置 (Authentication)
# ============================================================
# 登录用户名（默认: admin）
AUTH_USERNAME=admin
# 登录密码（留空则首次启动时自动生成并回写到 .env 文件）
AUTH_PASSWORD=
# JWT 签名密钥（留空则自动生成，但重启后 token 失效需重新登录）
AUTH_TOKEN_SECRET=

# 远程 MCP 外部接入无需配置。以下可选变量仅填 OAuth 受保护资源元数据，
# 供做发现流程的客户端读取；用 arc- API Key 以 Bearer 直连的客户端不会用到
# MCP_PUBLIC_URL=https://arcreel.example.com/mcp

# ============================================================
# PostgreSQL 配置
# ============================================================
# 数据库密码（必填，docker-compose 启动时会校验）
# 仅使用字母数字，避免 URL 特殊字符（@#/?% 等）导致 DATABASE_URL 解析失败
# 生成方法: openssl rand -hex 16
POSTGRES_PASSWORD=

# ============================================================
# 日志配置 (Logging)
# ============================================================
# 日志级别（默认: INFO，可选: DEBUG, WARNING, ERROR）
# LOG_LEVEL=INFO

# Generation content in logs (default: off). Prompts and model output are logged
# as length + digest; set to 1 to log excerpts while debugging a provider.
# 日志中的生成内容（默认关闭）：提示词与模型输出只记长度与摘要；排查供应商问题时设为 1 记录截断原文。
# ARCREEL_LOG_GENERATION_CONTENT=

# ============================================================
# Telemetry / 遥测
# ============================================================
# OTLP/HTTP trace export is enabled only when an endpoint is set.
# 仅在设置端点时启用 OTLP/HTTP 追踪导出。
# OTEL_EXPORTER_OTLP_ENDPOINT=
# DEPLOYMENT_ENVIRONMENT=production

# Key for HMAC references to provider job IDs and user-authored names in logs and
# spans. Unset, a random key is generated per process, so references change on
# every restart and cannot be matched across a crash/resume. Set a stable secret.
# 日志与 span 中供应商 job ID、用户命名的 HMAC 引用所用密钥。未设置时每次进程启动随机
# 生成，重启后引用变化、无法跨崩溃/续跑对齐。生产环境请设置固定密钥。
# ARCREEL_TELEMETRY_HMAC_KEY=
# ARCREEL_TELEMETRY_HMAC_KEY_VERSION=v1
