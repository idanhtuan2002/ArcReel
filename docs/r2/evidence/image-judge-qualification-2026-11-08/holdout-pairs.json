    },
    {
      "pair_id": "05_s2",
      "line": "Anh trai dừng lại, giọng run rẩy: 'Mẹ nói ai thương mẹ hơn thì để cho người đó lo.'",
      "own": "05_s2.png",
      "own_sha256": "sha256:9dfe16793d64468b9f25f7b87a982b48d909b181520343825604d6661e310ee3",
