    },
    {
      "pair_id": "05_s3",
      "line": "Em trai bước tới, nắm chặt tay anh và cùng nhau tưới nước cho gốc cây cỗi.",
      "own": "05_s3.png",
      "own_sha256": "sha256:4cb81f9e69187cc000a5001fe0286cc984be8cc8932a647f78354225e2f2d4a3",
