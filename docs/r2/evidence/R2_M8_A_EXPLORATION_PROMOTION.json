  "coverage_limits": [
    "Amendment 12 (sponsor decision) scopes this acceptance to M8-A and V2-02c. The V2-02d backfill rows in the fault matrix record its tests, but V2-02d is accepted on its own V2 track. Non-blocking findings are recorded here and do not open a new review round.",
    "The concurrent promotion, genesis, append and replay tests start two operations with asyncio.gather. They assert exactly one winner, but they do not force a particular lock interleaving.",
    "The forced interleavings are proven for the slot row (V2-02c test) and for the backfill window (V2-02d test). Its lock holder runs the same no-op UPDATE as HostSlotAuthority.lock_slot, but it is not a full M8 promotion.",
    "The historical logs are bound by sha256; the reviewer reads them but cannot rerun them in its read-only sandbox.",
    "Graph queries were not usable for this worktree in the reviews (approval-blocked). The single caller of promote_registered rests on source search and the architecture test."
  ],
  "deviations": [
    {
      "item": "CanonicalJsonObject",
      "planned": "spec \u00a74 models verbatim",
      "implemented": "an as_mapping model_serializer that dumps a JSON object; Decimal becomes int, or float if exact, otherwise it raises",
      "reason": "Canonical digests need a deterministic JSON object; the model fields are unchanged."
    },
    {
      "item": "router test tier and names",
      "planned": "tests/unit/server/routers, tests/unit/r2/advanced_creative/test_promotion.py",
      "implemented": "tests/integration/server/routers/test_advanced_creative_router.py, tests/unit/r2/advanced_creative/test_exploration_promotion.py",
      "reason": "audit_tests forbids a real DB in the unit tier, and the basename clashed with the host_hardening test."
    },
    {
      "item": "candidate identity keys",
      "planned": "PK candidate_id and PK (candidate_id, revision), each with a unique scope constraint",
      "implemented": "PK (user_id, project_name, candidate_id[, revision]); preview and receipt revision FKs carry the scope",
      "reason": "Spec: all public reads and writes scope by (user_id, project_name), and foreign and unknown IDs are indistinguishable. The global key made genesis on a foreign ID a 409 (ADR-0097 review round 1, rule 3)."
    },
    {
      "item": "preview references",
      "planned": "FK preview (by preview_id)",
      "implemented": "unique (user_id, project_name, preview_id) on previews; authorization and receipt FKs carry the scope",
      "reason": "Review round 2, finding 2: the database must refuse evidence bound to a preview from another scope."
    },
    {
      "item": "owner foreign key",
      "planned": "no cascade deletion from any evidence table",
      "implemented": "users.id ON DELETE RESTRICT on all six tables, instead of the UserOwnedMixin CASCADE",
      "reason": "It implements the plan rule; the mixin default contradicted it."
    },
    {
      "item": "ARTIFACT_SLOT scope",
      "planned": "promotion into an artifact slot",
      "implemented": "ADR-0097: an existing registered M7 candidate object is promoted into a non-manifest slot; verify_masters is scoped to EPISODE_VIDEO keys",
      "reason": "ADR-0095 and ADR-0096 authority boundaries (amendment 4)."
    },
    {
      "item": "M7 master authority backfill",
      "planned": "no M7 change",
      "implemented": "V2-02d (40337fe3, amendment 7) and its follow-ups (079679fb, amendment 8; fef820c3, amendment 9; 40972905, amendment 10; fc8bda2d, amendment 11): each artifact is verified, decided and promoted in one serialized_artifact transaction",
      "reason": "Review 2, finding 1 (race with Gate C), review 3 (missing or changed selected version), review 4 (unmanaged snapshot path), review 5 (invalid metadata, missing ffprobe) and review 6 (exhaustive sweep: unprojected heads, scan-to-lock changes, vanishing projects)."
    },
    {
      "item": "M7 promotion write order",
      "planned": "no M7 change",
      "implemented": "V2-02c (34bd4346, amendment 6): the pointer compare-and-set runs before the head version append",
      "reason": "Review 1, finding 2: the old order could deadlock against every row-lock holder."
    }
  ],
  "review_rounds": [
