{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:r2:m10:contract-design-acceptance:v1",
  "title": "M10 A0/A1 pure contract design acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "milestone",
    "accepted_design_head",
    "accepted_candidate_parent",
    "author_id",
    "contract_paths_and_sha256",
    "evidence_schema_paths_and_sha256",
    "bootstrap",
    "migration_boundary",
    "prerequisite_evidence",
    "scope_allowlist",
    "stop_codes",
    "reviewers",
    "rubric_version",
    "reviewed_at",
    "required_skips",
    "material_unknowns",
    "packet_definition",
    "implementation_scope",
    "full_m10_accepted",
    "runtime_activation_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "status": {
      "const": "M10_CONTRACT_DESIGN_ACCEPTED"
    },
    "milestone": {
      "const": "M10_A_A0_A1"
    },
    "accepted_design_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "accepted_candidate_parent": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "author_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_paths_and_sha256": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "evidence_schema_paths_and_sha256": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier",
        "tests"
      ],
      "properties": {
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "migration_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_base_head",
        "singleton_predecessor",
        "production_migration_authorized"
      ],
      "properties": {
        "implementation_base_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "singleton_predecessor": {
          "type": "string",
          "minLength": 1
        },
        "production_migration_authorized": {
          "const": false
        }
      }
    },
    "prerequisite_evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "accepted_head",
          "acceptance_artifact"
        ],
        "properties": {
          "owner": {
            "enum": [
              "M7",
              "M8"
            ]
          },
          "accepted_head": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "acceptance_artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      },
      "maxItems": 2
    },
    "scope_allowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(M10|POST_M8)_[A-Z0-9_]+$"
      }
    },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_id",
          "qualification_evidence",
          "conflict_declaration",
          "rubric_version",
          "reviewed_candidate_head",
          "verdict",
          "reviewed_at",
          "blind_review_artifact"
        ],
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "qualification_evidence": {
            "type": "string",
            "minLength": 1
          },
          "conflict_declaration": {
            "type": "string",
            "minLength": 1
          },
          "rubric_version": {
            "const": "R2_M10_CONTRACT_REVIEW_V1"
          },
          "reviewed_candidate_head": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "verdict": {
            "const": "PASS"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "blind_review_artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "rubric_version": {
      "const": "R2_M10_CONTRACT_REVIEW_V1"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "required_skips": {
      "type": "array",
      "maxItems": 0
    },
    "material_unknowns": {
      "type": "array",
      "maxItems": 0
    },
    "packet_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "implementation_scope": {
      "const": "CONTRACTS_ONLY"
    },
    "full_m10_accepted": {
      "const": false
    },
    "runtime_activation_authorized": {
      "const": false
    }
  },
  "$comment": "Bounded A0/A1 acceptance only; cannot authorize original A2-A7, full M10, database/probe/API/provider or runtime activation. Original full schema/gate remains unchanged."
}
