{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "base_head",
    "branch",
    "alembic_predecessor",
    "revision_graph_digest",
    "m8_acceptance",
    "m9_design_acceptance",
    "documents",
    "seams",
    "donors",
    "scope_allowlist",
    "create_paths",
    "required_skips",
    "material_unknowns",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "status": {
      "const": "M9_BASELINE_VERIFIED"
    },
    "base_head": {
      "const": "39b9c5dab5d0fd56cf52bf65e95355437cb1023b"
    },
    "branch": {
      "const": "impl/r2-m9a-opportunity-foundation"
    },
    "alembic_predecessor": {
      "const": "918c4a0e0001"
    },
    "revision_graph_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "m8_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "acceptance_commit",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "m9_design_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "acceptance_commit",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "documents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "seams": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "symbols"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "symbols": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "signature",
                "sha256"
              ],
              "properties": {
                "signature": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "donors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "commit",
          "files"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "files": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      },
      "uniqueItems": true
    },
    "scope_allowlist": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "create_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "required_skips": {
      "const": []
    },
    "material_unknowns": {
      "const": []
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
