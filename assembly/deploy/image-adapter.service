# Assembly BytePlus adapter (ASSEMBLY_PLAN D7): raises DramaClaw image sizes to Seedream 4.5 minimum, forwards the rest.
# Listens on the docker0 bridge address only, which DramaClaw's container reaches as host.docker.internal.
# Install: cp to ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now image-adapter
[Unit]
Description=Assembly BytePlus adapter (Seedream minimum size)


[Service]
WorkingDirectory=%h/content-production-os/.worktrees/r2-film-quality
ExecStart=%h/content-production-os/.worktrees/r2-film-quality/.venv/bin/python -m uvicorn assembly.image_adapter.app:app --host 172.17.0.1 --port 23360
Restart=on-failure

[Install]
WantedBy=default.target
