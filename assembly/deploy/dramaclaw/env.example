# DramaClaw CE settings for the assembly (ASSEMBLY_PLAN M0, D9). up.sh writes the real file to
# ~/assembly-data/deploy/dramaclaw/.env with a random PROMPT_EXPORT_PASSWORD; never commit the real file.
COMPOSE_PROJECT_NAME=assembly-dramaclaw
PROMPT_EXPORT_PASSWORD=__random__
# Loopback only: CE has no login.
ST_API_PORT=127.0.0.1:8780
ST_WEB_PORT=127.0.0.1:8080
# Vietnamese voices through our voice adapter (D9).
